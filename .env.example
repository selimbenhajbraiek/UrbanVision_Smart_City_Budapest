# Copy this file to `.env` (never commit `.env`).
# It is read by docker compose (database container) AND by the FastAPI backend.

# --- PostgreSQL / PostGIS -------------------------------------------------------
POSTGRES_USER=urbanvision
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=urbanvision
# Database used by the automated tests (created automatically by pytest).
POSTGRES_TEST_DB=urbanvision_test
POSTGRES_HOST=localhost
# 5433 avoids clashing with a locally installed PostgreSQL on 5432.
POSTGRES_PORT=5433

# --- Backend -------------------------------------------------------------------
LOG_LEVEL=INFO
# Comma-separated list of origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Data sources --------------------------------------------------------------
GTFS_URL=https://bkk.hu/gtfs/budapest_gtfs.zip
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_AIR_QUALITY_URL=https://air-quality-api.open-meteo.com/v1/air-quality
WEATHER_CACHE_TTL_SECONDS=600
OVERPASS_URL=https://overpass-api.de/api/interpreter

# --- Optional: real-time (Phase 10) ---------------------------------------------
# Free key from https://opendata.bkk.hu/ . Leave empty to disable live data.
BKK_API_KEY=
