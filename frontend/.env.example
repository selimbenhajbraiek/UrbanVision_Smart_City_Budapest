# Copy to `.env.local` if you need to change these (optional).

# Base URL of the backend API. Leave empty in development: Vite proxies /api to FastAPI.
# For a production build served from another host, set e.g. https://api.example.org
VITE_API_BASE_URL=

# Where the Vite dev server forwards /api requests (development only).
VITE_PROXY_TARGET=http://127.0.0.1:8000
